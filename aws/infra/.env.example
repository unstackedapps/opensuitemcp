# Copy to aws/infra/.env and fill in. Never commit aws/infra/.env.

# AWS CLI named profile (credentials stay in ~/.aws, not here)
AWS_PROFILE=your-profile
AWS_REGION=us-east-1

# Public hostname for the app (ACM cert + Route 53 alias + AUTH_URL)
DOMAIN_NAME=opensuitemcp.example.com

# Route 53 hosted zone that already exists in this account
HOSTED_ZONE_NAME=example.com
HOSTED_ZONE_ID=ZXXXXXXXXXXXXXX

# Optional: only if you need to pin the account instead of using the profile
# CDK_DEFAULT_ACCOUNT=

# GitHub Actions OIDC (owner/repo). Required once so CDK can create deploy roles.
# GITHUB_DEPLOY_REPO=owner/repo

# Optional: reuse an existing GitHub OIDC provider instead of creating one.
# Local/CDK env name is GITHUB_OIDC_PROVIDER_ARN. GitHub Actions variable must be
# OIDC_PROVIDER_ARN (names starting with GITHUB_ are reserved).
# GITHUB_OIDC_PROVIDER_ARN=arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com

# HTTPS origin ingress: public (default), cloudflare, or cidrs
# ORIGIN_INGRESS_MODE=public
# ALLOWED_HTTPS_CIDRS=203.0.113.0/24,2001:db8::/32

# New deployments enable Caddy HTTP basic auth unless this is false.
# Existing SSM parameter values are not overwritten on later deploys.
# HTTP_BASIC_AUTH_DEFAULT_ENABLED=true

# AWS Backup retention for the persistent EBS volume
# BACKUP_DAILY_RETENTION_DAYS=14
# BACKUP_WEEKLY_RETENTION_WEEKS=8

# CDK bootstrap qualifier (default hnb659fds)
# CDK_BOOTSTRAP_QUALIFIER=hnb659fds
